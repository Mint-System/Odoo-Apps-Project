<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="prepare_project_update_wizard_action" model="ir.actions.act_window">
        <field name="name">Prepare Project Update</field>
        <field name="res_model">prepare.project.update.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="project.model_project_project" />
        <field name="binding_type">action</field>
    </record>

    <record
        id="project_project_view_form_inherit_project_update_list"
        model="ir.ui.view"
    >
        <field name="name">project.project.form.inherit.project_update_list</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <field name="user_id" position="after">
                <field name="collaborator_ids">
                    <tree editable="bottom">
                        <field name="partner_id" options="{'no_create': True}" />
                    </tree>
                </field>
            </field>
        </field>
    </record>

</odoo>
