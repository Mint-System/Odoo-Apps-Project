<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="project_update_view_search" model="ir.ui.view">
        <field
            name="name"
        >project.update.view.search.inherit.project_update_list</field>
        <field name="model">project.update</field>
        <field name="inherit_id" ref="project.project_update_view_search" />
        <field name="arch" type="xml">
            <filter name="date" position="after">
                <separator />
                <filter
                    string="Batch"
                    name="group_by_batch"
                    context="{'group_by': 'batch'}"
                />
            </filter>
        </field>
    </record>

    <record id="project_update_view_tree" model="ir.ui.view">
        <field name="name">project.update.view.tree.project_update_list</field>
        <field name="model">project.update</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <tree editable="bottom" expand="context.get('expand', False)">
                <field name="id" invisible="1" />
                <field name="project_id" />
                <field name="partner_id" widget="many2one_avatar" optional="show" />
                <field
                    name="project_user_id"
                    widget="many2one_avatar_user"
                    optional="show"
                />
                <field name="name" optional="hide" />
                <field
                    name="status"
                    widget="status_with_color"
                    options="{'color_field': 'color'}"
                />
                <field
                    name="collaborator_ids"
                    widget="many2many_avatar_user"
                    optional="show"
                />
                <field name="date" />
                <field name="description" />
                <field name="batch" optional="hide" />
                <button
                    name="action_open_form"
                    title="View Update"
                    type="object"
                    string="View Update"
                    attrs="{'invisible': [('id', '=', False)]}"
                />
                <button
                    name="action_view_project_tasks"
                    title="View Tasks"
                    type="object"
                    string="View Tasks"
                    attrs="{'invisible': [('id', '=', False)]}"
                />
                <button
                    name="unlink"
                    title="Delete"
                    type="object"
                    icon="fa-trash"
                    attrs="{'invisible': [('id', '=', False)]}"
                />
            </tree>
        </field>
    </record>

    <record id="project_update_list_action" model="ir.actions.act_window">
        <field name="name">Project Updates</field>
        <field name="res_model">project.update</field>
        <field name="view_mode">tree,form</field>
        <field
            name="view_ids"
            eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'tree', 'view_id': ref('project_update_view_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('project.project_update_view_form')}),
        ]"
        />
        <field name="search_view_id" ref="project.project_update_view_search" />
        <field
            name="context"
        >{"search_default_group_by_batch": 1, "expand": True}</field>
    </record>

    <menuitem
        id="project_update_list_menu"
        parent="project.menu_project_report"
        action="project_update_list_action"
        sequence="80"
    />

</odoo>
