<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_edit_project_inherit_form" model="ir.ui.view">
        <field name="name">project_phase_estimate.view_edit_project_inherit_form</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="sale_project.view_edit_project_inherit_form" />
        <field name="arch" type="xml">

            <group name="group_sales_invoicing" position="inside">
                    <div>
                        <div class="o_setting_box" id="allow_estimate_container">
                            <div class="o_setting_left_pane">
                                <field name="allow_estimate" />
                            </div>
                            <div class="o_setting_right_pane">
                                <label for="allow_estimate" />
                                <div class="text-muted" id="allow_estimate_setting">
                                    Add estimates linked to phases to this project.
                                </div>
                            </div>
                        </div>
                    </div>
                </group>

        </field>
    </record>

    <record
        id="project_project_view_kanban_inherit_sale_timesheet_so_button"
        model="ir.ui.view"
    >
        <field
            name="name"
        >project_phase_estimate.project_project_view_kanban_inherit_sale_timesheet_so_button</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="priority">30</field>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('o_kanban_manage_view')]" position="inside">
                <field name="allow_estimate" invisible="1" />
                <div t-if="record.allow_estimate.raw_value" role="menuitem">
                    <a name="action_view_estimates" type="object">Phase Estimates</a>
                </div>
            </xpath>
        </field>
    </record>

    <record id="edit_project" model="ir.ui.view">
        <field name="name">project_phase_estimate.edit_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">

            <page name="description" position="after">
                <page
                    attrs="{'invisible': [('allow_estimate','=',False)]}"
                    name="project_estimates"
                    string="Project Estimates"
                >
                    <field
                        name="estimate_ids"
                        nolabel="1"
                        context="{'default_project_id': active_id}"
                    >
                        <tree editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="project_id" invisible="1" />
                            <field name="phase_id" />
                            <field name="planned_date_begin" optional="show" />
                            <field name="planned_date_end" optional="show" />
                            <field
                                name="planned_hours"
                                widget="timesheet_uom"
                                sum="Total Planned Hours"
                            />
                            <field
                                name="effective_hours"
                                widget="timesheet_uom"
                                optional="show"
                                sum="Total Effective Hours"
                            />
                            <field
                                name="remaining_hours"
                                widget="timesheet_uom"
                                optional="show"
                                sum="Total Remaining Hours"
                            />
                            <field
                                name="progress"
                                widget="progressbar"
                                optional="show"
                                sum="Project Progress (%)"
                            />
                        </tree>
                    </field>
                </page>
            </page>

        </field>
    </record>

</odoo>
