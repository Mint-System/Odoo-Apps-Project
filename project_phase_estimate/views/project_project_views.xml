<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="edit_project" model="ir.ui.view">
        <field name="name">project_phase_estimate.edit_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">
            <page name="description" position="after">
                <page name="project_estimates" string="Project Estimates" invisible="not allow_estimate">
                    <field name="estimate_ids" nolabel="1" context="{'default_project_id': id}">
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="project_id" column_invisible="1" />
                            <field name="phase_id" />
                            <field name="start_date" optional="hide" />
                            <field name="end_date" optional="hide" />
                            <field name="is_in_progress" optional="hide" />
                            <field name="planned_hours" widget="timesheet_uom" sum="Total Planned Hours" />
                            <field name="effective_hours" widget="timesheet_uom" sum="Total Effective Hours" />
                            <field name="remaining_hours" widget="timesheet_uom" sum="Total Remaining Hours" />
                            <field name="progress" widget="progressbar" optional="show" aggregator="avg" />
                            <button name="action_open_timesheets" string="View Timesheets" type="object" icon="fa-clock-o" />
                        </list>
                    </field>
                </page>
            </page>
            <xpath expr="//group[@name='group_time_managment']" position="inside">
                <setting id="estimate_settings" class="col-lg-12" help="Add estimates linked to phases to this project.">
                    <field name="allow_estimate" />
                </setting>
            </xpath>
        </field>
    </record>

    <record id="project_project_view_kanban_inherit_sale_timesheet_so_button" model="ir.ui.view">
        <field name="name">project_phase_estimate.project_project_view_kanban</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.view_project_kanban" />
        <field name="arch" type="xml">
            <xpath expr="//div[@name='card_menu_view']" position="inside">
                <field name="allow_estimate" invisible="1" />
                <div t-if="record.allow_estimate.raw_value" role="menuitem">
                    <a name="action_view_estimates" type="object">Phase Estimates</a>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
