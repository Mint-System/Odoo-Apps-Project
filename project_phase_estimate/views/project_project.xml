<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="edit_project" model="ir.ui.view">
        <field name="name">project_phase_estimate.edit_project</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project" />
        <field name="arch" type="xml">

            <page name="description" position="after">
                <page name="project_estimates" string="Project Estimates" invisible="not allow_estimate">
                    <field
                        name="estimate_ids"
                        nolabel="1"
                        context="{'default_project_id': id}"
                    >
                        <list editable="bottom">
                            <field name="sequence" widget="handle" />
                            <field name="project_id" invisible="1" />
                            <field name="phase_id" />
                            <field name="planned_date_begin" optional="show" />
                            <field name="planned_date_end" optional="show" />
                            <field name="planned_hours" widget="timesheet_uom" />
                            <field
                                name="effective_hours"
                                widget="timesheet_uom"
                                optional="show"
                            />
                            <field
                                name="remaining_hours"
                                widget="timesheet_uom"
                                optional="show"
                            />
                            <field
                                name="progress"
                                widget="progressbar"
                                optional="show"
                            />
                        </list>
                    </field>
                </page>
            </page>

            <xpath expr="//group[@name='group_time_managment']" position="inside">
                <setting class="col-lg-12" id="estimate_settings" string="Project Estimates" help="Add estimates linked to phases to this project">
                    <field name="allow_estimate"/>
                </setting>
            </xpath>

        </field>
    </record>

</odoo>
