<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_task_form" model="ir.ui.view">
        <field name="name">project_phase_estimate.view_task_form2</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='phase_id']" position="replace" />
            <xpath expr="//field[@name='user_ids']" position="before">
                <field
                    name="phase_id"
                    context="{'default_project_id': project_id}"
                    domain="[('project_ids', 'in', project_id), ('estimate_in_progress_count', '&gt;', 0)]"
                />
            </xpath>
            <xpath expr="//field[@name='phase_id']" position="after">
                <field name="show_estimate" invisible="1" />
                <field name="estimate_progress" widget="progressbar" invisible="not show_estimate" />
                <field
                    name="estimate_description"
                    string=""
                    readonly="1"
                    class="fst-italic text-muted"
                    invisible="not show_estimate"
                />
            </xpath>
            <xpath expr="//field[@name='child_ids']" position="attributes">
                <attribute name="context">{
                    'default_project_id': project_id,
                    'default_display_in_project': False,
                    'default_user_ids': user_ids,
                    'default_parent_id': id,
                    'default_partner_id': partner_id,
                    'default_milestone_id': allow_milestones and milestone_id,
                    'default_phase_id': phase_id,
                    'kanban_view_ref': 'project.project_sub_task_view_kanban_mobile',
                    'closed_X2M_count': closed_subtask_count,
                }</attribute>
            </xpath>
            <xpath expr="//field[@name='child_ids']/list/field[@name='milestone_id']" position="after">
                <field
                    name="phase_id"
                    optional="hide"
                    context="{'default_project_id': project_id}"
                    domain="[('project_ids', 'in', project_id), ('estimate_in_progress_count', '&gt;', 0)]"
                />
            </xpath>

        </field>
    </record>

    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">project_phase_estimate.view_task_form2_inherited</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//group/label[@for='allocated_hours']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//group/label[@for='allocated_hours']/following-sibling::div[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

</odoo>
